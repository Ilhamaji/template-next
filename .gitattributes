# Normalize line endings so Windows and POSIX checkouts agree.
* text=auto eol=lf

# Binary — never touch these.
*.ttf binary
*.woff binary
*.woff2 binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text

# Lockfile churn is not worth reviewing.
package-lock.json -diff linguist-generated
